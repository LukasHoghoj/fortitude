module integration
  implicit none
  abstract interface
    function func_iface(x) result(y)
      real, intent(in) :: x
      real :: y
    end function func_iface
  end interface
  type :: solver_t
    procedure(func_iface), pointer, nopass :: f => null()
  end type
contains
  real function integrate(f, a, b, g, h, p)
    procedure(func_iface) :: f
    procedure(func_iface), optional :: g
    procedure(real) :: h
    procedure(), pointer, intent(in) :: p
    real, intent(in) :: a, b
    real, external :: ext
    procedure(func_iface), pointer :: fp => null()
    integrate = (f(a) + f(b)) / 2
    fp => f
    if (present(g)) integrate = integrate + g(a)
  end function integrate
  subroutine run(s)
    type(solver_t), intent(inout) :: s
    real :: r
    r = integrate(square, 0.0, 1.0, h = square, p = null())
    r = s%f(2.0)
    call apply(f = square)
  end subroutine run
  real function square(x)
    real, intent(in) :: x
    square = x**2
  end function square
end module integration
module m2
